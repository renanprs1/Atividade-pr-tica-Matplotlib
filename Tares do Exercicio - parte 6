fig, ax = plt.subplots(figsize=(10, 5))
ax.plot(faturamento_mensal.index, faturamento_mensal.values,
        marker='o', color='navy', linewidth=2)

# Identificando o mês de maior faturamento
mes_pico = faturamento_mensal.idxmax()
valor_pico = faturamento_mensal.max()

ax.annotate(
    f'Pico: R$ {valor_pico:,.2f}',
    xy=(mes_pico, valor_pico),
    xytext=(mes_pico, valor_pico * 0.85),
    arrowprops=dict(facecolor='red', shrink=0.05, width=2, headwidth=10),
    fontsize=11, color='red', fontweight='bold',
    ha='center',
    bbox=dict(boxstyle='round,pad=0.3', fc='yellow', alpha=0.7)
)

ax.set_title('Faturamento Mensal com Destaque no Pico', fontsize=13, fontweight='bold')
ax.set_xlabel('Mês')
ax.set_ylabel('Faturamento (R$)')
ax.grid(True, linestyle=':', alpha=0.6)
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
